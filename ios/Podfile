# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug-dev' => :debug,
  'Profile-dev' => :release,
  'Release-dev' => :release,
  'Debug-prod' => :debug,
  'Profile-prod' => :release,
  'Release-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
      config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
      config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
    end
  end
  # RevenueCat_RevenueCatUI.bundle is produced by BOTH CocoaPods AND SPM.
  # Remove the CocoaPods bundle target completely so only SPM provides it.
  target_to_remove = installer.pods_project.targets.find do |t|
    t.name == 'RevenueCatUI-RevenueCat_RevenueCatUI'
  end
  if target_to_remove
    product_ref = target_to_remove.product_reference
    # Remove the native target itself
    target_to_remove.remove_from_project
    # Remove the product file reference (.bundle)
    product_ref&.remove_from_project
    # Remove any build file entries that referenced the removed product
    installer.pods_project.targets.each do |t|
      t.build_phases.each do |phase|
        next unless phase.respond_to?(:files)
        phase.files.to_a.each do |f|
          if f.display_name.to_s.include?('RevenueCat_RevenueCatUI')
            phase.remove_build_file(f)
          end
        end
      end
      # Strip from shell script input/output paths
      t.build_phases.each do |phase|
        next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
        phase.input_paths.reject!  { |p| p.to_s.include?('RevenueCat_RevenueCatUI') }
        phase.output_paths.reject! { |p| p.to_s.include?('RevenueCat_RevenueCatUI') }
      end
    end
    # Remove any container item proxy or target dependency pointing to old target
    installer.pods_project.root_object.targets.to_a.each do |t|
      next unless t.respond_to?(:dependencies)
      t.dependencies.reject! { |d| d.respond_to?(:name) && d.name.to_s.include?('RevenueCat_RevenueCatUI') }
    end
    installer.pods_project.save
  end
end





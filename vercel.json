{
  "version": 2,
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/dev-app", "destination": "/dev-app/index.html" },
    { "source": "/dev-app/(.*)", "destination": "/dev-app/index.html" }
  ]
}

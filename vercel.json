{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/dev-app", "destination": "/dev-app/index.html" },
    { "source": "/dev-app/:path*", "destination": "/dev-app/index.html" }
  ]
}
